(* ::Package:: *)

(* ====================================================================== *)
(*  Operadica`LittleCubes`                                                 *)
(*                                                                        *)
(*  The little n-cubes operad C_n: the geometric model of an E_n operad.   *)
(*                                                                        *)
(*  A configuration of k little cubes is a list of k cubes; a cube is a    *)
(*  list of n intervals {a, b} inside [0, 1], and the cubes have disjoint  *)
(*  interiors.  Composition inserts a configuration into one of the cubes  *)
(*  by the affine map that carries the unit cube onto it.  The symmetric   *)
(*  group relabels the cubes: (c.s)_j = c_{s(j)}.                          *)
(*                                                                        *)
(*  The axioms are polynomial identities in the endpoints, so they are     *)
(*  checked on GENERIC configurations with symbolic endpoints: that is a   *)
(*  proof for all configurations of the arities tested.                    *)
(*                                                                        *)
(*  Layer: operad.  Depends on: nothing (it produces operad objects for    *)
(*  the verifiers of Operadica`Operads`).                                  *)
(* ====================================================================== *)

BeginPackage["Operadica`LittleCubes`"];

LittleCubesOperad::usage = "LittleCubesOperad[n] gives the little n-cubes operad as a symmetric operad object. Its \"Elements\" are generic configurations with symbolic endpoints, so OperadAxiomCheck and OperadEquivarianceCheck prove the axioms as identities in the endpoints.";

LittleCubesCompose::usage = "LittleCubesCompose[c, i, d] inserts the configuration d into the i-th cube of the configuration c.";

LittleCubesAct::usage = "LittleCubesAct[c, s] relabels the cubes of c by the permutation s: the j-th cube of the result is the s(j)-th cube of c.";

LittleCubesQ::usage = "LittleCubesQ[c, n] gives True if c is a configuration of little n-cubes with numeric endpoints: every cube lies in the unit cube, is nondegenerate, and the interiors are pairwise disjoint.";

LittleCubesEqualQ::usage = "LittleCubesEqualQ[c, d] gives True if the configurations c and d agree after expanding their endpoints as polynomials.";

GenericLittleCubes::usage = "GenericLittleCubes[n, k, tag] gives the configuration of k little n-cubes whose endpoints are the symbols tag[j, mu, 1] and tag[j, mu, 2].";

RandomLittleCubes::usage = "RandomLittleCubes[n, k] gives a random configuration of k little n-cubes with rational endpoints.";

LittleCubesStabilize::usage = "LittleCubesStabilize[c] turns a configuration of little n-cubes into one of little (n+1)-cubes by taking the product with the unit interval. This is the map of operads C_n -> C_(n+1).";

SeparationNerve::usage = "SeparationNerve[n] gives the facets of the nerve of the cover of C_n(2) by the 2n sets 'cube 1 lies before/after cube 2 along axis mu'. It is the boundary of the n-dimensional cross-polytope, a sphere of dimension n - 1, which is the homotopy type of C_n(2).";

SimplicialBetti::usage = "SimplicialBetti[facets] gives the rational Betti numbers {b0, b1, ...} of the simplicial complex generated by the given facets (lists of vertices).";

Begin["`Private`"];

(* the affine image of the little cube r inside the cube q *)
insertCube[q_List, r_List] :=
  MapThread[
    Function[{iv, jv},
      {iv[[1]] + (iv[[2]] - iv[[1]]) jv[[1]], iv[[1]] + (iv[[2]] - iv[[1]]) jv[[2]]}
    ],
    {q, r}
  ];

LittleCubesCompose[c_List, i_Integer, d_List] :=
  Join[
    Take[c, i - 1],
    Map[Function[r, insertCube[c[[i]], r]], d],
    Drop[c, i]
  ];

LittleCubesAct[c_List, s_List] := c[[s]];

LittleCubesEqualQ[c_, d_] :=
  Dimensions[c] === Dimensions[d] &&
    AllTrue[Flatten[c - d], Function[e, Expand[e] === 0]];


disjointQ[q_List, r_List] :=
  AnyTrue[
    Transpose[{q, r}],
    Function[pair, pair[[1, 2]] <= pair[[2, 1]] || pair[[2, 2]] <= pair[[1, 1]]]
  ];

LittleCubesQ[c_List, n_Integer?Positive] :=
  AllTrue[c,
    Function[q,
      MatchQ[q, {Repeated[{_, _}, {n}]}] &&
        AllTrue[q, Function[iv, TrueQ[0 <= iv[[1]] < iv[[2]] <= 1]]]
    ]
  ] &&
  AllTrue[Subsets[c, {2}], Function[pair, TrueQ[disjointQ[pair[[1]], pair[[2]]]]]];


GenericLittleCubes[n_Integer?Positive, k_Integer?NonNegative, tag_] :=
  Table[{tag[j, mu, 1], tag[j, mu, 2]}, {j, 1, k}, {mu, 1, n}];


(* a random binary space partition of the unit cube into k boxes, each then
   shrunk a little, in random order *)
shrinkCube[q_List] :=
  Map[
    Function[iv,
      With[{w = iv[[2]] - iv[[1]]},
        {iv[[1]] + w RandomInteger[{0, 2}] / 10, iv[[2]] - w RandomInteger[{0, 2}] / 10}
      ]
    ],
    q
  ];

RandomLittleCubes[n_Integer?Positive, k_Integer?Positive] :=
  Module[{boxes = {ConstantArray[{0, 1}, n]}, pos, q, ax, lo, hi, cut},
    While[Length[boxes] < k,
      pos = RandomInteger[{1, Length[boxes]}];
      q = boxes[[pos]];
      boxes = Delete[boxes, pos];
      ax = RandomInteger[{1, n}];
      lo = q[[ax, 1]];
      hi = q[[ax, 2]];
      cut = lo + (hi - lo) RandomInteger[{1, 4}] / 5;
      boxes = Join[boxes, {ReplacePart[q, ax -> {lo, cut}], ReplacePart[q, ax -> {cut, hi}]}]
    ];
    RandomSample[Map[shrinkCube, boxes]]
  ];


LittleCubesStabilize[c_List] := Map[Function[q, Append[q, {0, 1}]], c];


LittleCubesOperad[n_Integer?Positive] :=
  <|
    "Name" -> "LittleCubes[" <> ToString[n] <> "]",
    "Dimension" -> n,
    "Elements" -> Function[k,
      Map[
        Function[tag, GenericLittleCubes[n, k, tag]],
        {\[FormalA], \[FormalB], \[FormalC]}
      ]
    ],
    "ElementsNote" -> "generic configurations with symbolic endpoints (an identity in the endpoints)",
    "Compose" -> LittleCubesCompose,
    "Unit" -> {ConstantArray[{0, 1}, n]},
    "Action" -> LittleCubesAct,
    "Equal" -> LittleCubesEqualQ
  |>;


(* ---------------------------------------------------------------------- *)
(* arity two: the homotopy type of C_n(2)                                 *)
(* ---------------------------------------------------------------------- *)

(* a vertex {mu, sign}: cube 1 lies before (+1) or after (-1) cube 2 along
   the axis mu.  Sets with distinct axes intersect in a contractible set;
   the two signs of one axis do not intersect. *)
SeparationNerve[n_Integer?Positive] :=
  Map[Function[signs, Transpose[{Range[n], signs}]], Tuples[{1, -1}, n]];


boundaryMatrix[low_List, high_List] :=
  Module[{index = AssociationThread[low, Range[Length[low]]]},
    Normal[
      SparseArray[
        Flatten[
          Table[
            {Lookup[index, Key[Delete[high[[j]], p]]], j} -> (-1)^(p - 1),
            {j, 1, Length[high]}, {p, 1, Length[high[[j]]]}
          ],
          1
        ],
        {Length[low], Length[high]}
      ]
    ]
  ];

SimplicialBetti[facets_List] :=
  Module[{simplices, top, byDim, rk},
    simplices = Union[
      Flatten[Map[Function[f, Subsets[Sort[f], {1, Length[f]}]], facets], 1]
    ];
    top = Max[Map[Length, simplices]];
    (* byDim[[k + 1]] lists the k-simplices *)
    byDim = Table[Select[simplices, Function[sx, Length[sx] === k + 1]], {k, 0, top - 1}];
    (* rk[[k + 1]] is the rank of the boundary from k-simplices to (k-1)-simplices *)
    rk = Join[
      {0},
      Table[MatrixRank[boundaryMatrix[byDim[[k]], byDim[[k + 1]]]], {k, 1, top - 1}],
      {0}
    ];
    Table[Length[byDim[[k + 1]]] - rk[[k + 1]] - rk[[k + 2]], {k, 0, top - 1}]
  ];

End[];

EndPackage[];
